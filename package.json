{
  "name": "grunt-tinypng-extended",
  "version": "1.0.0",
  "description": "Grunt plugin for compressing PNG, JPEG, WebP, AVIF, and other images with the official TinyPNG API, featuring caching, retries, parallel processing, metadata preservation, and summaries.",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "tasks",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nymo/grunt-tinypng-extended.git"
  },
  "bugs": {
    "url": "https://github.com/nymo/grunt-tinypng-extended/issues"
  },
  "homepage": "https://github.com/nymo/grunt-tinypng-extended#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run build",
    "coverage": "vitest run --coverage --coverage.include=dist/**/*.js --coverage.exclude=test/** --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=json-summary",
    "precoverage": "npm run build"
  },
  "author": {
    "name": "Gregor Panek",
    "email": "gp@gregorpanek.de",
    "url": "https://github.com/nymo"
  },
  "keywords": [
    "gruntplugin",
    "tinypng",
    "image",
    "img",
    "picture",
    "photo",
    "minify",
    "compress",
    "png",
    "webp",
    "jpeg",
    "avif"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "license": "GPL-3.0-only",
  "peerDependencies": {
    "grunt": ">=1.0.0"
  },
  "dependencies": {
    "ansi-colors": "^3.2.4",
    "fancy-log": "^1.3.3",
    "minimatch": "^5.1.9",
    "minimist": "^1.2.0",
    "plugin-error": "^1.0.1",
    "tinify": "^1.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "grunt": "^1.6.1",
    "nock": "^13.5.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
